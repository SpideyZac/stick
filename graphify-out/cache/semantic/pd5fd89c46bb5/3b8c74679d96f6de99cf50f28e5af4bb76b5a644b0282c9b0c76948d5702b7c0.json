ro_velocity_update", "target": "prompt_orientation_quaternion", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_swing_stats", "target": "prompt_address_calibration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_swing_stats", "target": "prompt_impact_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_swing_stats", "target": "prompt_face_to_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_swing_stats", "target": "prompt_club_data_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_ball_flight_estimate", "target": "prompt_face_to_path", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_ball_flight_estimate", "target": "prompt_smash_factor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_ball_flight_estimate", "target": "prompt_projectile_drag_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_ball_flight_estimate", "target": "prompt_swing_stats", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"sour