{"nodes": [{"id": "prompt_golf_swing_tracker", "label": "Golf Swing Tracker Build Prompt", "file_type": "document", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompt_bmi270_sensor_setup", "label": "BMI270 Sensor Setup", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accel +/-16g and gyro +/-2000 dps chosen because both have headroom for high school swing speeds. No magnetometer, so absolute heading is unobservable by design."}, {"id": "prompt_mock_imu_stream", "label": "Mock IMU Stream Generator", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No hardware exists yet, so the entire pipeline is developed and tested against canned swings played back at a realistic rate."}, {"id": "prompt_imu_source_interface", "label": "IMU Source Interface Boundary", "file_type": "rationale", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolating the input layer behind one interface lets a real BLE data source be swapped in later without touching anything downstream."}, {"id": "prompt_canned_swings", "label": "Canned Swing Fixtures", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Good swing, slice tendency, hook tendency, and waggle then swing, so detection and stats both get exercised on known inputs."}, {"id": "prompt_club_data_table", "label": "Club Length Table", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompt_driver_excluded", "label": "Driver Out of Scope", "file_type": "rationale", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The driver is the one club that gets teed up, so the grounded club address height calibration would not hold for it. Every other club gets swept off the ground."}, {"id": "prompt_swing_start_detection", "label": "Swing Start Detection", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The record tap happens before the golfer settles into address, so t=0 walks back to the last true stillness point rather than using the tap."}, {"id": "prompt_waggle_rejection", "label": "Waggle Rejection", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A waggle spikes then returns to baseline and tends to reverse rotational direction. A real takeaway holds above threshold for 100-150ms and stays roughly monotonic in one direction."}, {"id": "prompt_address_calibration", "label": "Address Calibration", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The club is grounded during the stillness period, giving a known clubhead height of 0 to sanity check plus a square to target reference frame every later face angle and path number is measured against."}, {"id": "prompt_no_double_integration", "label": "No Double Integration for Position", "file_type": "rationale", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Double integrating the accelerometer drifts badly over a swing length window, so position becomes a geometry problem via forward kinematics instead of an integration problem."}, {"id": "prompt_orientation_quaternion", "label": "Orientation Quaternion Integration", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompt_forward_kinematics", "label": "Forward Kinematics Clubhead Position", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Known club length plus a fixed IMU offset from the grip, rotated by the current orientation quaternion."}, {"id": "prompt_zero_velocity_update", "label": "Zero Velocity Updates", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Address and the top of the backswing are both near zero angular velocity moments, so they anchor orientation error before it builds across the swing."}, {"id": "prompt_swing_stats", "label": "Swing Stats Set", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tempo, phase durations, peak angular velocity, clubhead speed at impact, swing plane, attack angle, face angle, path, and face to path."}, {"id": "prompt_impact_detection", "label": "Impact Detection from Accel Spike", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompt_face_to_path", "label": "Face to Path Difference", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Face to path, not face to target, is what drives hook and slice, so it is the number reported and the proxy the flight model curves on."}, {"id": "prompt_ball_flight_estimate", "label": "Ball Flight Estimate", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not aiming for launch monitor accuracy. Without real spin data the face to path difference stands in as a spin axis proxy for curve direction and amount."}, {"id": "prompt_smash_factor", "label": "Smash Factor Constant", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Published typical values per club type, roughly 1.33-1.38 for mid irons and lower for wedges."}, {"id": "prompt_projectile_drag_model", "label": "Projectile Model with Drag", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drag coefficient is hardcoded rather than configurable, since the estimate does not need that level of tuning."}, {"id": "prompt_3d_visualization", "label": "3D Swing Visualization", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drawing the target line from the address reference frame makes path and face angle visually obvious instead of only numeric."}, {"id": "prompt_performance_constraint", "label": "Phone Browser Performance Constraint", "file_type": "rationale", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target is iOS Safari on a phone at a driving range, not a dev machine, so math and rendering stay lightweight and unnecessary re-renders are avoided."}, {"id": "prompt_ui_requirements", "label": "One Handed Phone UI", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used one handed on a driving range or practice green, so a club picker and a big record button dominate and the post swing readout is a single glance."}, {"id": "prompt_git_conventions", "label": "Conventional Commit Discipline", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small frequent commits after every fix, feat, or chore rather than one giant dump at the end."}, {"id": "prompt_writing_style_rule", "label": "Plain Comment and Copy Style Rule", "file_type": "concept", "source_file": "PROMPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Short plain comments only where code is not self explanatory, no em dashes anywhere in code, comments, or UI text."}], "edges": [{"source": "prompt_golf_swing_tracker", "target": "prompt_bmi270_sensor_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_golf_swing_tracker", "target": "prompt_mock_imu_stream", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_mock_imu_stream", "target": "prompt_imu_source_interface", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_mock_imu_stream", "target": "prompt_canned_swings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "prompt_mock_imu_stream", "target": "prompt_bmi270_sensor_setup", "relation":