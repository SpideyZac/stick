{"nodes": [{"id": "readme_stick", "label": "Stick README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_pipeline_architecture", "label": "Stick Pipeline Architecture", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The UI knows about SwingAnalysis and nothing else, the pipeline knows about ImuSource and nothing else. That two sided ignorance is what keeps the sensor swappable."}, {"id": "readme_imusource", "label": "ImuSource", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delivers samples in batches because that is how BLE notifications arrive, so the mock and a real sensor have identical shape."}, {"id": "readme_mockimusource", "label": "MockImuSource", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_swingdetector", "label": "SwingDetector", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_analyzeswing", "label": "analyzeSwing", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_swinganalysis", "label": "SwingAnalysis", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ble_swap_point", "label": "BLE Swap Point", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implementing ImuSource and handing it to SwingDetector in place of MockImuSource is the only change a real sensor requires."}, {"id": "readme_bmi270_constants", "label": "BMI270 Range Constants", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "16g and 2000 dps at 400 Hz is about 5.6 kB/s packed as int16. The canned swings peak near 1880 dps and 16g so they deliberately exercise the top of both ranges."}, {"id": "readme_physically_consistent_mock", "label": "Physically Consistent Mock", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acceleration is derived from the same motion that generates the gyro trace. The synthesizer models the hands with its own constants that the analysis never sees, so the pipeline is not graded against its own assumptions. Noise, per axis bias, and quantization are all modelled."}, {"id": "readme_yaw_unobservable", "label": "Yaw Unobservability", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No magnetometer pins absolute heading, but every reported angle is relative to the address frame and a swing lasts about a second, so drift does not matter. It would matter over minutes, which is why t=0 anchors to the last stillness rather than the record tap."}, {"id": "readme_gyro_bias_estimation", "label": "Gyro Bias Estimation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A couple of degrees per second left in place integrates into several degrees across a swing, larger than the face angles being reported. It is estimated from the still window before takeaway, which is why that window leaves a guard band ahead of t=0 and filters to genuinely quiet samples."}, {"id": "readme_two_stage_waggle_rejection", "label": "Two Stage Waggle Rejection", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cheap check at 120ms commits to capturing and keeps t=0 accurate. A second check at the end discards anything that got that far and never produced contact, catching a waggle big and slow enough to survive the first pass. Buffering is cheap, so a wrong provisional capture costs nothing."}, {"id": "readme_two_segment_club_model", "label": "Two Segment Club Model", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hub the arms pivot about plus the shaft. Pinning the grip at a point costs about twenty percent of clubhead speed since much of it comes from the hands travelling. It is also a representability question: a 7 iron at 80 mph off a fixed grip needs over 2300 dps at the sensor, past what a BMI270 can report at all."}, {"id": "readme_hand_speed_from_accelerometer", "label": "Hand Speed from the Accelerometer", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The accelerometer sits at the grip so it sees the grip's own acceleration. Velocity is one integration, not two, and it starts from a boundary condition known for free: the club is still at address. Over the second to impact that holds up."}, {"id": "readme_arm_length_position_constraint", "label": "Arm Length Position Constraint", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Position is still two integrations and still drifts, so direction comes from the integral and distance comes from the arms, a fixed length that cannot drift. That removes the radial error that would visibly stretch and squash the golfer's arms. The residual slides the hands along their own arc and only the replay depends on it."}, {"id": "readme_accelerometer_bias_floor", "label": "Accelerometer Bias Accuracy Floor", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A still sensor gives one vector, and a tilted sensor is indistinguishable from a sideways biased one. The error is absorbed into the address frame as a tilt of about a degree and carries into every angle measured against it. Only the along gravity component is recoverable. Calibrating the accelerometer is what buys accuracy here, not anything in this repo."}, {"id": "readme_no_driver", "label": "No Driver Support", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The address calibration assumes a grounded club and the driver is the one club that gets teed up."}, {"id": "readme_pipeline_round_trip_test", "label": "Pipeline Round Trip Test", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The synthesizer knows exactly what face angle, path, and speed it produced, so the pipeline has to give those back from nothing but noisy, biased, quantized samples. Recovery inside a degree is the accelerometer bias floor rather than the maths."}, {"id": "readme_grip_test", "label": "Grip Hand Speed Test", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks recovered hand speed against the synthesizer's known hand motion, the same round trip idea applied to one quantity."}], "edges": [{"source": "readme_stick", "target": "readme_pipeline_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_pipeline_architecture", "target": "readme_imusource", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_imusource", "target": "readme_swingdetector", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_swingdetector", "target": "readme_analyzeswing", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_analyzeswing", "target": "readme_swinganalysis", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_mockimusource", "target": "readme_imusource", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_ble_swap_point", "target": "readme_imusource", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_ble_swap_point", "target": "readme_swingdetector", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_ble_swap_point", "target": "readme_mockimusource", "rel